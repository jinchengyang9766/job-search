# Copy to .env. Empty model names keep external AI disabled.
# Verify model availability in your own provider account; no model ID is assumed.
OPENAI_API_KEY=
JOB_AGENT_PROVIDER=openai
JOB_AGENT_EXTRACT_MODEL=
JOB_AGENT_ANALYZE_MODEL=
JOB_AGENT_TIMEOUT_SECONDS=60
JOB_AGENT_MAX_OUTPUT_TOKENS=6000
# Local data defaults to ./data; relative paths are resolved from this project.
JOB_AGENT_DATA_DIR=data
JOB_AGENT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
